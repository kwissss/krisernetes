{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#11.0.0",
    "github>home-operations/renovate-presets//apps/cnpg.json5#11.0.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#11.0.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#11.0.0",
    ":timezone(Europe/Oslo)",
  ],
  // The Main ruleset does not require up-to-date branches, and `auto` would
  // still rebase every automerge PR each time main moves
  rebaseWhen: "conflicted",
  customDatasources: {
    // Grafana installs plugins from the Grafana.com catalog, which lists a
    // version only after review, later than the GitHub release
    "grafana-plugins": {
      defaultRegistryUrlTemplate: "https://grafana.com/api/plugins/{{packageName}}/versions",
      transformTemplates: [
        '{"releases": [items.{"version": version, "releaseTimestamp": createdAt}], "sourceUrl": items[0].url}',
      ],
    },
  },
  customManagers: [
    {
      customType: "regex",
      description: "Process annotated container image dependencies (repo:tag@digest)",
      managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
      matchStrings: [
        "# renovate-image: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[\\w.-]+:\\s*[^:\\s]+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}docker{{/if}}",
    },
  ],
  packageRules: [
    // Auto-merge rules
    {
      description: "Auto-merge trusted OCI digests",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["/home-operations/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge high-cadence OCI packages weekly",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      schedule: ["before 6am on Monday"],
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "3 days",
      ignoreTests: false,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\\//", "/^renovatebot\\//"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "1 minute",
      ignoreTests: false,
    },
    {
      description: "Auto-merge Grafana dashboards",
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge Renovate Presets",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    // Grouping rules
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubectl/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      // Counts image references, not packages: the 6 from registry.k8s.io plus at least
      // one kubelet, so the PR waits for ghcr.io/siderolabs/kubelet to be published.
      minimumGroupSize: 7,
    },
    {
      // Unites the factory installer image and the tuppr upgrade version
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      // The runners sidecar tag must match the n8n version
      description: "n8n Group",
      groupName: "n8n",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/n8n-io/n8n", "ghcr.io/n8n-io/runners"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Keep CloudNativePG on Postgres 18 until the extension images move with it",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      allowedVersions: "/^18\\./",
    },
    // Labeling rules
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    // Changelogs
    {
      description: "Changelog URL for lspdapplication",
      matchPackageNames: ["/lspdapplication/"],
      changelogUrl: "https://github.com/spiizor/lspdapplication/commits/main/",
    },
    {
      description: "Changelog URL for hypixel-discord-chat-bridge",
      matchPackageNames: ["/hypixel-discord-chat-bridge/"],
      changelogUrl: "https://github.com/duckysolucky/hypixel-discord-chat-bridge/commits/main/",
    },
  ],
}
